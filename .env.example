# Four Wheeler Ride Along — environment variables
# Copy this file to .env.local for local dev, and set the same values
# as Environment Variables in the Vercel project dashboard for production.

# --- Brevo (transactional email) ---
# Brevo dashboard → Settings → SMTP & API → API Keys → Generate a new API key (v3)
BREVO_API_KEY=

# The "from" address — must be a verified sender in Brevo
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=4W Ride Along Form

# Where each submission is emailed
ADMIN_EMAIL_PRIMARY=
ADMIN_EMAIL_CC=

# --- Google Sheets submission log ---
# Apps Script Web App URL (see scripts/google-sheets-submission-log.gs).
# At least one of Brevo or this must be configured for submissions to work.
GOOGLE_SHEET_WEBAPP_URL=
